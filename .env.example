# Notion
# Get from: https://www.notion.so/my-integrations → New integration
NOTION_TOKEN=secret_xxxx
# The ID of your tasks database (from the database URL: notion.so/workspace/<DATABASE_ID>?v=...)
NOTION_DATABASE_ID=xxxx

# Google Calendar
# Get from: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Set redirect URI to: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# News — no API key needed (uses Google News RSS + optional custom RSS feeds)
# Configure topics and feeds in dashboard.config.js

# GitLab
# Token: your company GitLab → User Settings → Access Tokens → scope: read_api
GITLAB_TOKEN=glpat-xxxx
# Your company GitLab base URL (no trailing slash)
GITLAB_URL=https://gitlab.yourcompany.com

PORT=3000
